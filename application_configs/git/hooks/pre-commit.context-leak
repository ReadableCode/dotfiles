#!/usr/bin/env sh
# pre-commit: refuse a commit that stages another context's identifiers.
# Deployed into <repo>/.git/hooks/pre-commit by the context overlays (see
# dotfiles/docs/repo_client_credentials.md, "Context leak check"). Hooks live in
# the main checkout's .git even for worktrees, so the dotfiles sibling is two
# levels up from this file. Fails closed: no checker, no commit.
HOOK_DIR="$(cd "$(dirname "$0")" && pwd)"
DOTFILES="$(cd "$HOOK_DIR/../.." && pwd)/../dotfiles"
CHECK="$DOTFILES/src/context_leak_check.py"
if [ ! -f "$CHECK" ]; then
    echo "pre-commit: context leak checker not found at $CHECK (dotfiles must be cloned beside this repo)" >&2
    exit 1
fi
# The interpreter is dotfiles' own venv, never PATH: deploy itself is
# `uv run` inside dotfiles, so every machine carrying this hook has that venv,
# whereas on Windows the first `python3` on PATH is the Microsoft Store alias,
# a stub that only prints an install prompt (VS Code shows it as a modal
# "Git: Python was not found" dialog and the commit dies). The checker is
# stdlib-only; the venv is used for its interpreter, not its packages.
PY=""
for CANDIDATE in "$DOTFILES/.venv/bin/python" "$DOTFILES/.venv/Scripts/python.exe"; do
    if [ -x "$CANDIDATE" ]; then PY="$CANDIDATE"; break; fi
done
if [ -z "$PY" ]; then
    echo "pre-commit: no python in $DOTFILES/.venv; run 'uv sync' in dotfiles so the context leak check can run" >&2
    exit 1
fi
TOP="$(git rev-parse --show-toplevel)"
"$PY" "$CHECK" --staged --repo "$TOP" || exit 1
# A repo that uses the pre-commit framework keeps its own checks: this file
# replaced the hook `pre-commit install` wrote, so run the framework on the
# staged files exactly as that hook would have. The framework is a dev
# dependency, so it lives in the repo's own venv, not on PATH; look there
# first (a worktree has its own .venv beside its own .pre-commit-config.yaml),
# then on PATH. Fails closed like the hook it replaced: no framework, no
# commit, so a missing linter is red rather than silently skipped.
if [ -f "$TOP/.pre-commit-config.yaml" ]; then
    for PRE_COMMIT in "$TOP/.venv/bin/pre-commit" "$TOP/.venv/Scripts/pre-commit.exe" "$(command -v pre-commit 2>/dev/null)"; do
        if [ -n "$PRE_COMMIT" ] && [ -x "$PRE_COMMIT" ]; then
            cd "$TOP" && exec "$PRE_COMMIT" run
        fi
    done
    echo "pre-commit: $TOP has a .pre-commit-config.yaml but pre-commit is not installed (looked in $TOP/.venv and on PATH); run 'uv sync' so its own checks can run" >&2
    exit 1
fi
exit 0
