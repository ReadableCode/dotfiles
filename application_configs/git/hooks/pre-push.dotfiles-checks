#!/usr/bin/env sh
# pre-push: refuse a push whose code does not pass this repo's own checks.
# Deployed into dotfiles/.git/hooks/pre-push by the personal_dev overlay (see
# dotfiles/docs/howto_formatting.md). Hooks are untracked, hence a manifest
# entry.
#
# Pre-PUSH and not pre-commit on purpose: a commit is a local checkpoint and
# should stay cheap, but nothing that reaches a remote should need a follow-up
# "fix lint" commit. The context-leak check is the opposite trade and stays at
# pre-commit, because a leaked identifier must never be written into history at
# all, not merely kept off the remote.
#
# It runs THIS repo's own pinned tools through uv - the commands CLAUDE.md
# documents - rather than the pre-commit framework, which would be a second set
# of linter pins alongside pyproject.toml and uv.lock.
#
# Fails closed: no uv, no push. `git push --no-verify` skips it, which is the
# escape hatch for a push that has to go out now.

set -e

TOP="$(git rev-parse --show-toplevel)"

# A push that only DELETES remote branches has no new code to check. git feeds
# pre-push "<local ref> <local sha> <remote ref> <remote sha>" lines on stdin,
# and a delete is the all-zero local sha.
DELETES_ONLY=1
SAW_REF=0
while read -r _local_ref local_sha _remote_ref _remote_sha; do
    [ -z "$local_sha" ] && continue
    SAW_REF=1
    case "$local_sha" in
    *[!0]*) DELETES_ONLY=0 ;;
    esac
done
if [ "$SAW_REF" = 1 ] && [ "$DELETES_ONLY" = 1 ]; then
    exit 0
fi

if ! command -v uv > /dev/null 2>&1; then
    echo "pre-push: uv is not installed, so this repo's checks cannot run; install uv or push with --no-verify" >&2
    exit 1
fi

cd "$TOP"

# The same commands as CLAUDE.md's "Python environment & tooling" and "Tests",
# cheapest first so a formatting slip fails before the suite runs. ruff check
# covers what flake8 and isort used to, in one pass.
#
# --check and no --fix: a hook REPORTS. Rewriting files mid-push would leave the
# fixed versions outside the commits being pushed, so you would push the
# unformatted code anyway and find a dirty tree afterwards. The message names
# the one command that fixes it instead.
run_check() {
    echo "pre-push: $*"
    if ! uv run "$@"; then
        echo "pre-push: '$*' failed. Fix with:" >&2
        echo "    uv run ruff format . && uv run ruff check --fix ." >&2
        echo "  then amend or commit. To push anyway: git push --no-verify" >&2
        exit 1
    fi
}

run_check ruff format --check .
run_check ruff check .
run_check mypy .
run_check pytest -q

echo "pre-push: checks passed"
exit 0
