# Detect the type of terminal: WSL, Linux, or macOS — sets $TERMINAL_TYPE
detect_terminal_type() {
    if grep -qEi "(Microsoft|WSL)" /proc/version 2>/dev/null; then
        TERMINAL_TYPE="WSL"
    elif [[ "$OSTYPE" == "linux-gnu"* ]]; then
        TERMINAL_TYPE="Linux"
    elif [[ "$OSTYPE" == "darwin"* ]]; then
        TERMINAL_TYPE="macOS"
    else
        TERMINAL_TYPE="Unknown"
    fi
}

detect_terminal_type

### Paths ###

# Ordered candidates for the git projects directory. First one that EXISTS wins —
# a candidate whose directory is absent is skipped, so a machine without ~/GitHub
# falls through to a later one.
_git_dir_candidates=("$HOME/GitHub/" "$HOME/GitHubWSL/")

# Context shards call this to add their own root; they must never assign gitDir
# directly. Appended candidates are tried last, so a client root can never win on
# a machine that also has a personal one.
git_dir_fallback() {
    _git_dir_candidates+=("$1")
}

set_git_dir() {
    local _c
    gitDir=""
    for _c in "${_git_dir_candidates[@]}"; do
        if [ -d "$_c" ]; then
            gitDir="$_c"
            break
        fi
    done
    # Exported so child processes (cmdr, scripts) see the same resolution the
    # shell made - they must never re-derive this themselves.
    export gitDir
}

### Context shards ###

# Context-specific aliases live in per-context shard files deployed by each
# *_credentials overlay manifest into ~/.shell_local.d/ (one shard per
# context, so a machine with several contexts cloned sources them all).
# Sourced BEFORE set_git_dir runs so a shard can register a root candidate via
# git_dir_fallback; gitDir is resolved once afterwards, then used by everything
# below (down to the ssh alias loader at the end of this file).
_load_context_shards() {
    # zsh errors out on a non-matching glob; bash leaves it literal and the
    # [[ -f ]] check below skips it.
    [[ -n "$ZSH_VERSION" ]] && setopt localoptions nullglob
    local _shard
    for _shard in "$HOME/.shell_local.d"/*.sh; do
        [[ -f "$_shard" ]] && source "$_shard"
    done
    return 0
}
_load_context_shards

