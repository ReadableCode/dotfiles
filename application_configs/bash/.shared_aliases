# Run a python script with the right interpreter for ITS project, from any cwd.
#
# Walks up from the script's own directory for the nearest ancestor that looks
# like a project root (declares a pyproject.toml or carries a .venv), then:
#   uv run   — root has a pyproject.toml and uv is installed. uv creates and
#              syncs .venv on first use, so a fresh clone just works.
#   .venv    — root has one but is not a uv project.
#   system python — neither.
#
# The whole body runs in a ( ... ) subshell, so the cd and the venv activation
# cannot leak into the calling shell however the script exits.
#
# The PowerShell twin (run-python-script in powershell_aliases.ps1) resolves
# the same three ways. The two had drifted: bash had the walk-up search and the
# subshell, PowerShell had the uv branch (be3bfd4, 2026-08-11). Merged
# 2026-08-15 — change both or neither.
function run_python_script() {
    if [ -z "$1" ]; then
        echo "Usage: run_python_script <python_script_path> [args...]" >&2
        return 1
    fi
    (
        script_path=$(realpath "$1" 2>/dev/null)
        [ -f "$script_path" ] || { echo "Script not found: $1" >&2; exit 1; }
        shift
        script_dir=$(dirname "$script_path")

        # Nearest ancestor holding either project marker, starting at the
        # script's own directory. Empty when there is no project above it.
        find_project_root() {
            local dir="$1"
            while [ "$dir" != "/" ]; do
                if [ -f "$dir/pyproject.toml" ] || [ -d "$dir/.venv" ]; then
                    echo "$dir"
                    return
                fi
                dir=$(dirname "$dir")
            done
        }

        echo "Running Python script: $script_path"
        echo "Changing to script directory: $script_dir"
        # Stay in the script's directory, not the project root: scripts that
        # open files by relative path expect it, and uv finds the project by
        # walking up from here anyway.
        cd "$script_dir" || exit 1

        project_root=$(find_project_root "$script_dir")

        if [ -n "$project_root" ] && [ -f "$project_root/pyproject.toml" ] && command -v uv >/dev/null 2>&1; then
            echo "uv project detected at: $project_root"
            uv run python "$script_path" "$@"
            exit $?
        fi

        if [ -n "$project_root" ] && [ -d "$project_root/.venv" ]; then
            echo "Project .venv detected at: $project_root/.venv"
            # bin on POSIX, Scripts under git-bash/MSYS on Windows.
            if [ -f "$project_root/.venv/bin/activate" ]; then
                source "$project_root/.venv/bin/activate"
            elif [ -f "$project_root/.venv/Scripts/activate" ]; then
                source "$project_root/.venv/Scripts/activate"
            fi
            python3 "$script_path" "$@"
            exit $?
        fi

        echo "No uv project or .venv found. Running with system Python."
        python3 "$script_path" "$@"
    )
}

