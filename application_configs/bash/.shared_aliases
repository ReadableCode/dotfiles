alias ll='ls -AlhF'

# Open the files this branch changed (vs the merge-base with the default branch) in VSCode.
# Skips deleted/renamed-away paths and never includes changes that only happened upstream.
function openbranchdiffs() {
    local root base f
    local -a files=()
    root=$(git rev-parse --show-toplevel 2>/dev/null) || { echo "Not a git repository." >&2; return 1; }
    cd "$root" || return 1
    git fetch -q
    base=$(git symbolic-ref --short refs/remotes/origin/HEAD 2>/dev/null || echo origin/master)
    # base...HEAD diffs from the merge-base, so only this branch's own commits count;
    # --diff-filter=d drops files deleted on this branch
    while IFS= read -r f; do
        [ -e "$f" ] && files+=("$f")
    done < <(git diff --name-only --diff-filter=d "$base"...HEAD)
    if [ ${#files[@]} -eq 0 ]; then
        echo "No files changed on this branch relative to $base."
        return 0
    fi
    code "${files[@]}"
}

# Fuzzy-pick a branch (most recently committed first, remotes included) and switch to it.
# Esc aborts; picking a remote-only branch creates the local tracking branch via git switch.
function gsw() {
    command -v fzf >/dev/null 2>&1 || { echo "fzf is not installed" >&2; return 1; }
    git rev-parse --git-dir >/dev/null 2>&1 || { echo "Not a git repository." >&2; return 1; }
    git branch -a --sort=-committerdate --format='%(refname:short)' \
        | sed 's|^origin/||' | grep -vx 'HEAD' | awk '!seen[$0]++' \
        | fzf --preview 'git log --oneline --color=always -10 {}' --ansi \
        | xargs -r git switch
}

function gitpullall() {
    local arch os bin
    arch=$(uname -m)
    os=$(uname -s | tr '[:upper:]' '[:lower:]')
    bin="$gitDir/dotfiles/go_apps/git_puller/git_puller"

    if [[ "$os" == "darwin" ]]; then
        # macOS: pick arm or x86 binary
        if [[ "$arch" == "arm64" || "$arch" == "aarch64" ]]; then
            bin="${bin}_mac_arm"
        else
            bin="${bin}_mac_x86"
        fi
    elif [[ "$os" == "linux" ]]; then
        # Linux: arm gets a suffix; x86 uses the default binary name
        if [[ "$arch" == "arm64" || "$arch" == "aarch64" ]]; then
            bin="${bin}_arm"
        fi
    fi

    chmod +x "$bin"
    "$bin" -path "$gitDir" -r
    echo ""
	echo ""

    if command -v uv >/dev/null 2>&1; then
        # Offer missing clones after the pulls (the pulls refresh the
        # <context>_repos.yaml configs in the *_credentials repos) and BEFORE
        # the deploy, since a fresh clone may be a deploy target.
        printf '\033[1;36m%s\033[0m\n' '──────────────  Checking for repos to clone  ──────────────'
        (cd "$gitDir/dotfiles" && uv run python src/clone_repos.py)
        echo ""
        # Deploy after the pulls: idempotent, and re-links the hard links
        # the pulls just orphaned (no-symlink machines like work laptops).
        printf '\033[1;36m%s\033[0m\n' '──────────────  Deploying configs  ──────────────'
        (cd "$gitDir/dotfiles" && uv run python src/deploy_configs.py)
        echo ""
        # Prune last, with --apply: the removals files are a committed list of
        # paths that must not exist, so every machine has to act on them for
        # the list to ever be finished. A dry run here would reprint the same
        # dead links forever and still need a second command by hand. Safe
        # after the deploy because prune only removes a path a removals entry
        # names AND no live manifest entry wants (see docs/deploy_configs.md).
        printf '\033[1;36m%s\033[0m\n' '──────────────  Pruning removed configs  ──────────────'
        (cd "$gitDir/dotfiles" && uv run python src/deploy_configs.py prune --apply)
    else
        echo "uv not found, skipping repo clone check, config deploy and prune."
    fi
}

### tmux ###

# Attach to a shared tmux session with an INDEPENDENT view per device.
# Plain `tmux attach` puts every client in the SAME session, and the active
# window is session state — so tapping a tab on the iPad drags every other
# screen along. Grouped sessions (new-session -t <group>) share the window
# list but each keep their own current window: windows opened/closed on one
# device appear everywhere, tab selection stays per-device.
#
# Usage: ta [name]   (default session name: main)
# First caller creates the real session; later callers get a throwaway view
# session named <name>-<host>-<pid> with destroy-unattached ON, scoped to
# that view session only, so disconnecting cleans it up while the group's
# windows live on. Pairs with aggressive-resize in tmux/.tmux.conf.
function ta() {
    command -v tmux >/dev/null 2>&1 || { echo "tmux is not installed" >&2; return 1; }
    [ -n "$TMUX" ] && { echo "already inside tmux" >&2; return 1; }
    local base="${1:-main}"
    # =name pins has-session to an exact match — bare names prefix-match, so
    # a leftover "main-envy-123" view would otherwise count as "main".
    if tmux has-session -t "=$base" 2>/dev/null; then
        # View names must be UNIQUE PER CLIENT: if a name collides (re-used
        # shell pid, ta re-run after detach), new-session would attach the
        # second client into the FIRST client's view and the two screens
        # mirror each other — bump the name until it's free.
        local view="${base}-$(_ssh_local_hostname)-$$"
        while tmux has-session -t "=$view" 2>/dev/null; do
            view="${view}-$RANDOM"
        done
        tmux new-session -t "$base" -s "$view" \; set-option destroy-unattached on
    else
        tmux new-session -s "$base"
    fi
}

### Script Shortcuts ###

# cmdr: the fleet CLI/TUI (go_apps/cmdr). Its binary is built per machine,
# never committed, so build on first use when go is available. A release
# install will replace this shim eventually (docs/unified_cli_tui.md).
function cmdr() {
    local dir="$gitDir/dotfiles/go_apps/cmdr"
    local bin="$dir/cmdr"
    # cargo-run semantics: rebuild only when a source file is newer than the
    # binary (a git pull freshens mtimes, so the next run after a pull
    # rebuilds itself). The mtime scan costs ~10ms; a no-op go build costs
    # ~10x that, so go is only invoked when something actually changed.
    local stale=""
    if [ ! -x "$bin" ]; then
        stale=1
    elif [ -n "$(find "$dir" \( -name '*.go' -o -name 'go.mod' -o -name 'go.sum' \) -newer "$bin" 2>/dev/null | head -n 1)" ]; then
        stale=1
    fi
    if [ -n "$stale" ]; then
        if command -v go >/dev/null 2>&1; then
            echo "cmdr: rebuilding (sources changed)..."
            (cd "$dir" && go build .) || return 1
        elif [ -x "$bin" ]; then
            echo "cmdr: sources changed but go is not installed - running the existing binary"
        else
            echo "cmdr: not built and go is not installed (wanted $bin)"
            return 1
        fi
    fi
    "$bin" "$@"
}

# deployconfigs: run the dotfiles config deploy from anywhere (uv resolves the
# repo venv via --project, so no cd needed). Args pass straight through and the
# script itself defaults to `deploy`, so bare `deployconfigs` deploys and
# `deployconfigs prune --apply` / `deployconfigs status` work as written.
function deployconfigs() {
    if ! command -v uv >/dev/null 2>&1; then
        echo "deployconfigs: uv is not installed (wanted to run src/deploy_configs.py)"
        return 1
    fi
    uv run --project "$gitDir/dotfiles" python "$gitDir/dotfiles/src/deploy_configs.py" "$@"
}

