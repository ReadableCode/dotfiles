### SSH Shortcuts (generated from <gitDir>/*_credentials host inventories) ###

# Short, lowercase local hostname — zsh sets HOST, bash sets HOSTNAME, and
# neither is guaranteed, so fall back to the command and strip any domain.
# Used by ta() above; the alias generator works its own out in Python.
_ssh_local_hostname() {
    local name="${HOSTNAME:-}"
    [[ -z "$name" ]] && name="${HOST:-}"
    [[ -z "$name" ]] && name="$(hostname 2>/dev/null)"
    name="${name%%.*}"
    printf '%s' "$(echo "$name" | tr '[:upper:]' '[:lower:]')"
}

# The ssh (and macOS vnc) aliases are built by ONE cross-shell generator,
# <gitDir>/dotfiles/src/ssh_aliases.py: it reads every <gitDir>/*_credentials
# host inventory and prints ready-to-eval `alias` lines. The PowerShell profile
# evals that same script's --format powershell output, so jump-host resolution,
# port handling, user selection and vnc aliases have a single implementation
# instead of two twins kept in step by hand. See its module docstring and
# docs/client_credentials_repos.md for the inventory schema.
#
# Stdlib-only, so bare python3 runs it before any venv exists — and it is ONE
# process for all inventories, where the old loader spawned one per file. No
# python3 (or no generator on disk) just means no ssh aliases; nothing else in
# this file depends on them.
_load_ssh_aliases() {
    [[ -n "$gitDir" ]] || return 0
    command -v python3 >/dev/null 2>&1 || return 0
    local generator="${gitDir%/}/dotfiles/src/ssh_aliases.py"
    [[ -f "$generator" ]] || return 0
    local generated
    # Assigned first and eval'd only on success, so a generator that dies
    # mid-output can never leave the shell evaluating a half-written alias.
    generated="$(python3 "$generator" --format bash --root "${gitDir%/}")" || return 0
    eval "$generated"
}

_load_ssh_aliases
