# macOS Homebrew formulae and casks.
#
# Installed by scripts/install_mac_apps.sh, or straight with
# `brew bundle --file=app_lists/Brewfile`.
#
# Installs needing more than a plain entry (a tap that must be trusted first,
# vendor installers, App Store apps) stay in mac_apps_non_brew.md - they cannot
# be installed from a plain list.
#
# This is what any Mac gets, whichever context owns it: the tools and the
# browsers. What only some contexts' Macs get lives in each context's
# <context>_app_lists.yaml, which src/app_lists.py adds to this list on
# member machines; a name two contexts both list is offered once.
brew "bat"
brew "bitwarden-cli"
brew "black"
brew "btop"
brew "colima"
brew "docker"
brew "docker-compose"
brew "exiftool"
brew "fastfetch"
brew "fd"
brew "fzf"
brew "gdu"
brew "gh"
brew "git"
brew "go"
brew "htop"
brew "iperf3"
brew "jq"
brew "mosh"
brew "ncdu"
brew "neovim"
brew "nmap"
brew "node"
brew "ollama"
brew "pandoc"
# pango pulls glib/cairo/harfbuzz/fontconfig - the native stack WeasyPrint
# dlopens for PDF generation (any repo using weasyprint needs these on mac)
brew "pango"
# pwsh exists ONLY so powershell_aliases.ps1 edits can be parse-checked
# (`pwsh -NoProfile`) before they ship to the Windows machines. It never
# becomes a login shell or default anything - just a prefix-contained binary
# (formula, not cask: no pkg installer, no sudo; pulls in dotnet).
brew "powershell"
brew "pylint"
brew "python"
brew "ripgrep"
brew "speedtest-cli"
brew "tldr"
brew "tmux"
brew "tree"
brew "uv"
brew "wget"
brew "yq"

cask "dockdoor"
cask "firefox"
cask "google-chrome"
cask "hammerspoon"
cask "maccy"
cask "tailscale-app"
cask "visual-studio-code"
